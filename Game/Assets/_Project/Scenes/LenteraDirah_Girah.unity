  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.92, g: 0.9, b: 0.86, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 20
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "<b>TUJUAN</b>\nKumpulkan 3 Lontar Suci (Usada, Dharma, Rwa Bhineda) di sektor utara, barat, dan timur desa, lalu sentuh Altar Penyucian di tengah desa.\n\n<b>KONTROL</b>\n[WASD / Panah]  Bergerak 4 arah\n[SPACE]  Holy Light Burst \u2014 membekukan Bayangan Wabah di sekitar selama 3 detik\n[E] atau klik tombol  \u2014 melanjutkan dialog\n\n<b>ENERGI LENTERA</b>\nEnergi menyusut 2% per detik dan radius cahaya ikut mengecil. Ambil Minyak Obor untuk menambah +35% energi. Bila energi habis, permainan berakhir.\n\n<b>BAYANGAN WABAH</b>\nHindari patrolinya. Burst memakai 15% energi (cooldown 4 detik, radius 3.5 unit). Tersentuh musuh mengurangi 1 nyawa; kamu kebal 1 detik setelahnya.\n\n<b>TIPS</b>\nAmati pola patroli sebelum mengambil Lontar, dan simpan energi untuk situasi terjepit."
